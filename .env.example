# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7

# CTF Target Configuration
CTF_TARGET_HOST=localhost
CTF_TARGET_PORT=8000
ALLOWED_NETWORKS=127.0.0.1/8,localhost

# Agent Configuration
MAX_AGENT_STEPS=50
COMMAND_TIMEOUT=30
TOOL_TIMEOUT=60

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data/chroma

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_RELOAD=true

# Flag Patterns (comma-separated regex patterns)
FLAG_PATTERNS=CTF\{[^}]+\},FLAG\{[^}]+\},flag\{[^}]+\}

# Docker Configuration
DOCKER_IMAGE_NAME=ctf-demo-challenge
DOCKER_CONTAINER_NAME=ctf-demo-challenge-container
